# Copy to .env and fill in. .env is gitignored; Bun loads it automatically
# from the repo root. Only `skillsmith eval` reads it — validate, generate,
# and check are fully offline.

# Judge credentials for trigger evals. Needs an API account with billing:
# a Claude subscription does not cover API calls. Run cost and cadence are
# in docs/evals.md.
ANTHROPIC_API_KEY=sk-ant-...
